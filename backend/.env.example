# Copy this file to ".env" (same folder) and fill in your own values.
# The real .env file is private and is NOT uploaded to GitHub.
DB_HOST=localhost
DB_PORT=3306
DB_USER=coderace_app
DB_PASSWORD=change-me
DB_NAME=coderace

# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440